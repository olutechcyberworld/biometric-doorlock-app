<?xml version="1.0" encoding="utf-8"?>
<!--
  Local-network-only prototype (Rev 2 doc Section 2.6: TLS on the app<->lock link is explicitly out of scope).
  The Device Address screen lets the owner enter either the mDNS hostname (doorlock.local) or a raw local IP
  they typed themselves - Android's Network Security Config only matches an exact hostname or an exact IP
  literal per <domain> entry (no CIDR/wildcard IP ranges), so a per-IP domain-config can't cover "whatever IP
  the owner's router happens to hand out". Scoping by hostname only would silently block the raw-IP path the
  Home screen itself invites, so cleartext is permitted for the whole app instead. This app has no other
  network traffic (see docs/APP_PROTOCOL.md) - the base-config below matches what it actually does today; when
  that changes (e.g. an HTTPS-hosted asset is added later), tighten this back to a scoped <domain-config>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
