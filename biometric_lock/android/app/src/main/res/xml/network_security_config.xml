<?xml version="1.0" encoding="utf-8"?>
<!--
  Scopes cleartext (plain HTTP/WS) traffic to only the door lock's local
  network, instead of allowing it app-wide.

  Covers the mDNS hostname (doorlock.local, and any other *.local host)
  used by DeviceClient by default. If you ever connect by raw IP address
  instead (e.g. mDNS resolution fails on your router), add a second
  <domain> entry below with that literal IP - domain-config in Android's
  Network Security Config does not support IP ranges/CIDR, only exact
  hostnames or exact IP literals.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">local</domain>
        <!-- Example fallback if you connect by IP instead of doorlock.local:
        <domain includeSubdomains="false">192.168.1.50</domain>
        -->
    </domain-config>
</network-security-config>